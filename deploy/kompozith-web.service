[Unit]
Description=Kompozith website (Express: static build + CMS API)
After=network.target

[Service]
User=www-data
WorkingDirectory=/var/www/prod/kompozith-web
EnvironmentFile=/etc/kompozith-web.env
ExecStart=/usr/bin/npx tsx server/index.ts
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
